---
import { getCollection } from "astro:content";
import FormList from "../components/FormList.astro";
import Base from "../layouts/Base.astro";
import { office } from "../office";

const all = (await getCollection("forms")).sort(
  (a, b) => a.data.order - b.data.order,
);
const office_forms = all.filter((form) => "office" in form.data);
const sections = [
  ...new Set(
    all.flatMap((form) => ("section" in form.data ? [form.data.section] : [])),
  ),
];
const groups = sections.map((section) => ({
  title: section,
  forms: all.filter(
    (form) => "section" in form.data && form.data.section === section,
  ),
}));
---

<Base
  title="Forms"
  description="Printable forms for small claims, evictions, and weddings in the Ward 10 Justice of the Peace Court."
>
  <h1>Forms</h1>
  <p class="lede">
    Print a form and fill it in by hand. The office can also give you a paper
    copy.
  </p>
  <p>
    You do not have to use these forms. In a justice of the peace court you may
    state your claim in your own words, in writing or in person. The forms make
    sure the court gets every fact it needs. The one exception is the notice to
    vacate: the law requires a landlord to give it in writing.
  </p>
  <p>{office.how_to_file}</p>
  {groups.map((group) => (
    <>
      <h2>{group.title}</h2>
      <FormList forms={group.forms} />
    </>
  ))}
  <h2>Office forms</h2>
  <details class="office-forms">
    <summary>Show office forms</summary>
    <p>
      Forms the Justice of the Peace uses in the office. If you think you need
      one, ask the office.
    </p>
    <FormList forms={office_forms} />
  </details>
</Base>
