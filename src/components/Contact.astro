---
import { office, telephone_link } from "../office";
import ExternalLink from "./ExternalLink.astro";

const { street, city, state, zip } = office.address;
const locality = `${city}, ${state} ${zip}`;
const map_query = encodeURIComponent(`${street}, ${locality}`);
const map_url = `https://www.google.com/maps/search/?api=1&query=${map_query}`;
---

<dl class="contact">
  <dt>Address</dt>
  <dd>
    <address>
      {street}
      <br />
      {locality}
    </address>
    <ExternalLink href={map_url}>Map and directions</ExternalLink>
  </dd>
  <dt>Telephone</dt>
  <dd>
    <a href={telephone_link(office.phone)}>{office.phone}</a>
  </dd>
  <dt>Email</dt>
  <dd>
    <a href={`mailto:${office.email}`}>{office.email}</a>
  </dd>
  <dt>Hours</dt>
  {office.hours.map((line) => (
    <dd>{line}</dd>
  ))}
</dl>
